# Reference template for DSE 6.9 Cassandra configuration.
# Adapt this template to the exact configuration generated by your
# supported DSE 6.9 installation method.

cluster_name: '{{ dse_cluster_name }}'
listen_address: '{{ dse_listen_address }}'
rpc_address: '{{ dse_rpc_address }}'

seed_provider:
  - class_name: org.apache.cassandra.locator.SimpleSeedProvider
    parameters:
      - seeds: '{{ dse_seed_nodes | join(",") }}'
